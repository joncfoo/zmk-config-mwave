#include <dt-bindings/advertising_mode.h>
#include <behaviors/advertising_mode.dtsi>
#include <behaviors/stp_indicators.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/keys.h>
#include "studio-macros.dtsi"

/ {
    #include "mwave_prim.dtsi"

    behaviors {
        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <125>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <47 48 49 50>;
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <125>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <53 54 55 56>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";

            // -------------------------------------------------------------------------------------------------------
            // | ESC | F1  | F2  | F3  | F4  | F5  | F6  | | F7  | F8  | F9  | F10 | F11 | F12 |HOME| END |PSCN|  1  |
            // |GRAVE|  1  |  2  |  3  |  4  |  5  |  6  | |   7   |  8  |  9  |  0  |  -  |  =  |    BKSP     | DEL |
            // | TAB    |  Q  |  W  |  E  |  R  |   T    | |   Y  |  U  |  I  |  O  |  P  |  [  |  ]  |   \    |     |
            // | CAPS     |  A  |  S  |  D  |  F  |  G   | |  H    |  J  |  K  |  L  |  ;  |  '  |    ENTER    | PGUP|
            // |   SHIFT   |  Z  |  X  |  C  |  V  |  B  | |    N    |  M  |  ,  |  .  |  /  |   SHIFT   | UP  | PGDN|
            // |  CTL  |  WIN  |  ALT  |      SPACE      | |      SPACE        | ALT | MENU |RCTRL| LEFT| DOWN |RIGHT|
            // -------------------------------------------------------------------------------------------------------

            bindings = <
&mo 1                              &kp F1        &kp F2           &kp F3                &kp F4             &kp F5         &kp F6         &kp F7              &kp F8            &kp F9            &kp F10               &kp F11           &kp F12    &kp HOME       &kp END  &kp F13  &to 2
&mt TILDE GRAVE                    &kp NUMBER_1  &kp NUMBER_2     &kp NUMBER_3          &kp NUMBER_4       &kp N5         &kp NUMBER_6   &kp N7              &kp N8            &kp N9            &kp N0                &kp MINUS         &kp EQUAL  &kp BSPC
&kp TAB                            &kp Q         &kp W            &kp E                 &kp R              &kp T          &kp Y          &kp U               &kp I             &kp O             &kp P                 &kp LBKT          &kp RBKT   &kp BACKSLASH  &kp DEL
&mt LA(LC(LG(LEFT_SHIFT))) ESCAPE  &hml LCTRL A  &hml LEFT_ALT S  &hml LEFT_GUI D       &hml LEFT_SHIFT F  &kp G          &kp H          &hmr RIGHT_SHIFT J  &hmr RIGHT_GUI K  &hmr RIGHT_ALT L  &hmr RCTRL SEMICOLON  &kp SINGLE_QUOTE  &kp RET    &kp PG_UP
&kp LSHFT                          &kp Z         &kp X            &kp C                 &kp V              &kp B          &kp N          &kp M               &kp COMMA         &kp PERIOD        &kp SLASH             &kp RSHFT         &kp UP     &kp PG_DN
&kp LCTRL                          &kp LEFT_ALT  &kp LEFT_GUI     &mt LEFT_SHIFT SPACE  &kp SPACE          &kp RIGHT_GUI  &kp RIGHT_ALT  &kp RCTRL           &kp LEFT          &kp DOWN          &kp RIGHT
            >;
        };

        layer_8 {
            display-name = "Base";
            bindings = <
&kp ESC                            &kp C_MUTE    &kp C_VOL_DN     &kp C_VOL_UP          &kp C_PREV         &kp C_PP       &kp C_NEXT     &bl BL_CYCLE        &kp F11           &kp LS(LC(LG(NUMBER_4)))  &kp LC(UP_ARROW)      &kp LG(SPACE)     &bth 0 0   &kp SCROLLLOCK  &kp PAUSE_BREAK  &kp K_POWER  &to 2
&mt TILDE GRAVE                    &kp NUMBER_1  &kp NUMBER_2     &kp NUMBER_3          &kp NUMBER_4       &kp N5         &kp NUMBER_6   &kp N7              &kp N8            &kp N9                    &kp N0                &kp MINUS         &kp EQUAL  &kp BSPC
&kp TAB                            &kp Q         &kp W            &kp E                 &kp R              &kp T          &kp Y          &kp U               &kp I             &kp O                     &kp P                 &kp LBKT          &kp RBKT   &kp BACKSLASH   &kp DEL
&mt LA(LC(LG(LEFT_SHIFT))) ESCAPE  &hml LCTRL A  &hml LEFT_ALT S  &hml LEFT_GUI D       &hml LEFT_SHIFT F  &kp G          &kp H          &hmr RIGHT_SHIFT J  &hmr RIGHT_GUI K  &hmr RIGHT_ALT L          &hmr RCTRL SEMICOLON  &kp SINGLE_QUOTE  &kp RET    &kp PG_UP
&kp LSHFT                          &kp Z         &kp X            &kp C                 &kp V              &kp B          &kp N          &kp M               &kp COMMA         &kp PERIOD                &kp SLASH             &kp RSHFT         &kp UP     &kp PG_DN
&kp LCTRL                          &kp LEFT_ALT  &kp LEFT_GUI     &mt LEFT_SHIFT SPACE  &kp SPACE          &kp RIGHT_GUI  &kp RIGHT_ALT  &kp RCTRL           &kp LEFT          &kp DOWN                  &kp RIGHT
            >;
        };

        raise {
            display-name = "Fn";
            bindings = <
&kp ESCAPE      &kp F1        &kp F2        &kp F3     &kp F4      &kp F5         &kp F6      &kp F7     &kp F8       &kp F9         &kp F10          &kp F11          &kp F12    &kp HOME       &kp END     &kp K_POWER  &to 0
&kp GRAVE       &kp N1        &kp N2        &kp N3     &kp N4      &kp N5         &kp N6      &kp N7     &kp KP_NLCK  &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp MINUS        &kp EQUAL  &kp BACKSPACE
&kp TAB         &kp Q         &kp W         &kp E      &kp R       &kp T          &kp Y       &kp KP_N7  &kp KP_N8    &kp KP_N9      &kp KP_MINUS     &kp LBKT         &kp RBKT   &kp BSLH       &kp DELETE
&studio_unlock  &kp A         &kp S         &kp D      &kp F       &kp G          &kp H       &kp KP_N4  &kp KP_N5    &kp KP_N6      &kp KP_PLUS      &kp SQT          &kp ENTER  &kp PAGE_UP
&kp LEFT_SHIFT  &kp Z         &kp X         &kp C      &macro_ver  &kp B          &kp N       &kp KP_N1  &kp KP_N2    &kp KP_N3      &kp KP_ENTER     &kp RIGHT_SHIFT  &kp UP     &kp PAGE_DOWN
&kp LCTRL       &kp LEFT_ALT  &kp LEFT_GUI  &kp SPACE  &kp KP_N0   &kp RIGHT_GUI  &kp KP_DOT  &kp RCTRL  &kp LEFT     &kp DOWN       &kp RIGHT
            >;
        };

        extra1 {
            display-name = "Blue";
            status = "reserved";
        };

        extra2 {
            display-name = "Green";
            status = "reserved";
        };

        extra3 {
            display-name = "Red";
            status = "reserved";
        };

        extra4 {
            display-name = "Purple";
            status = "reserved";
        };

        extra5 {
            display-name = "Cyan";
            status = "reserved";
        };

        extra6 {
            display-name = "Yellow";
            status = "reserved";
        };
    };
};
